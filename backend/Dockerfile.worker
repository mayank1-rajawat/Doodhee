FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/migrate ./cmd/migrate \
    && CGO_ENABLED=0 go build -trimpath -o /out/worker ./cmd/event-worker

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D doodhee
USER doodhee
COPY --from=build /out/migrate /migrate
COPY --from=build /out/worker /worker
ENTRYPOINT ["/bin/sh", "-c", "/migrate && exec /worker"]
