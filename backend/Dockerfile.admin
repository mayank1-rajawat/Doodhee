FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/migrate ./cmd/migrate \
    && CGO_ENABLED=0 go build -trimpath -o /out/gateway ./cmd/admin-gateway

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D doodhee
USER doodhee
ENV HTTP_ADDR=0.0.0.0:80
EXPOSE 80
COPY --from=build /out/migrate /migrate
COPY --from=build /out/gateway /gateway
ENTRYPOINT ["/bin/sh", "-c", "/migrate && exec /gateway"]
